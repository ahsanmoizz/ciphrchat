# CiphrChat Bootstrap Relay & Coturn Environment Configuration
# Copy this file to .env on the deployment VPS and fill in production values.

# Relay Ports and Bindings
CIPHRCHAT_HEALTH_PORT=8080
CIPHRCHAT_RELAY_TCP_PORT=4001
CIPHRCHAT_RELAY_QUIC_PORT=4001

# Storage Directories and Quotas
CIPHRCHAT_MAILBOX_DIRECTORY=/var/lib/ciphrchat/mailbox
CIPHRCHAT_FILES_DIRECTORY=/var/lib/ciphrchat/files
CIPHRCHAT_FILE_STORAGE_QUOTA_BYTES=53687091200 # 50 GiB total storage quota

# Coturn / WebRTC Media Relay Configuration
TURN_REALM=ciphrchat.internal
TURN_PUBLIC_URL=turn:YOUR_VPS_PUBLIC_IP_OR_DOMAIN:3478
TURN_STATIC_AUTH_SECRET=GENERATE_RANDOM_LONG_SECRET_HERE
